@model IEnumerable<Customer>
<h2 style="text-align:center;background-color:yellowgreen;color:red"> Customer Details</h2>
<table align="center" border="1" class="table">
    <tr>
        <th>@Html.DisplayNameFor( c => c.Custid)</th>
        <th>@Html.DisplayNameFor(c => c.Name)</th>
        <th>@Html.DisplayNameFor(c => c.Balance)</th>
        <th>@Html.DisplayNameFor(c => c.City)</th>
        <th>@Html.DisplayNameFor(c => c.Status)</th>
        <th>Actions</th>
    </tr>
    @foreach(Customer cust in Model)
    {
        <tr>
            <td align="center">@Html.DisplayFor(c =>cust.Custid)</td>
            <td>@Html.DisplayFor(c => cust.Name)</td>
            <td>@Html.DisplayFor(c => cust.Balance)</td>
            <td>@Html.DisplayFor(c => cust.City)</td>
            <td align="center">@Html.DisplayFor(c => cust.Status)</td>
            <td>
                <a asp-action="DisplayCustomer" asp-route-Custid="@cust.Custid">Details</a>&nbsp;
                <a asp-action="EditCustomer" asp-route-Custid="@cust.Custid">Edit</a>&nbsp;
                <a asp-action="DeleteCustomer" asp-route-Custid="@cust.Custid">Delete</a>
            </td>
        </tr>
    }
    <tr>
      <td colspan="6" align="center">
          <a asp-action="AddCustomer">Add New Customer</a>
      </td>
    </tr>
</table>